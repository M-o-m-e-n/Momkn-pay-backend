# Copy to .env and fill in the blanks. Never commit .env.

# --- database ---
DB_HOST=db
DB_PORT=5432
DB_NAME=momknpay
DB_USER=momknpay
DB_PASSWORD=change-me

# --- crypto ---
# wraps session keys at rest; generate with: openssl rand -base64 32
APP_MASTER_KEY=
# private key of the session handshake; generate with: ./scripts/generate-session-keypair.sh
# (the matching public key is not secret: it is built into the apps)
APP_SESSION_PRIVATE_KEY=

# --- TLS --- see docs/LLD.md §13.3
TLS_KEYSTORE_PATH=/certs/keystore.p12
TLS_KEYSTORE_PASSWORD=change-me

# --- optional overrides ---
# APP_SESSION_TTL=PT30M
# APP_INQUIRY_TTL=PT5M
# APP_SLOW_DELAY=PT8S
# APP_PENDING_DELAY=PT10S
